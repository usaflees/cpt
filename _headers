# Cloudflare Pages response headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/  (max 100 rules, 2,000 chars per line)
#
# The CSP lists every host the site talks to. If you add a new data source or script
# (e.g. a new exchange API), add its host to connect-src / script-src or the browser will block it.
# frame-ancestors is * on purpose: other sites embed the ticker widget in an iframe.
# Google Tag Manager / GA4 (assets/consent.js) needs googletagmanager.com and the google-analytics
# collection hosts. GTM "Custom HTML" tags will not run (no 'unsafe-inline'); use built-in tag types.
# The 'sha256-…' in script-src allows the inlined theme script (assets/theme-init.js); it is
# rewritten by scripts/build-coin-pages.mjs, and seo-lint fails if any inline script lacks a hash.
# The Link header sends the Binance preconnect as a 103 Early Hint: Pages skips <link> tags that
# carry extra attributes such as crossorigin, so the one in the HTML is never hinted.

/*
  Strict-Transport-Security: max-age=31536000
  Link: <https://data-api.binance.vision>; rel=preconnect; crossorigin
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Speculation-Rules: "/speculation-rules.json"
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-Zo9OG/I3R70u3wzf3dYv7AXGCZHhLUUJqpyqArq6oFE=' https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://data-api.binance.vision https://api.coinbase.com https://api.exchange.coinbase.com wss://data-stream.binance.vision wss://ws-feed.exchange.coinbase.com wss://ws.kraken.com https://cloudflareinsights.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; manifest-src 'self'; frame-ancestors *; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Prerender same-site links on hover (Chromium). The JSON must have this exact media type.
/speculation-rules.json
  Content-Type: application/speculationrules+json
  Cache-Control: public, max-age=3600

# The service worker must always be revalidated so updates reach visitors.
/sw.js
  Cache-Control: no-cache

# Site code and styles: every page links them with a content hash (?v=…, written by
# scripts/build-coin-pages.mjs), so a new version is a new URL and the old one can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and the social images rarely change: let browsers cache them for a week.
/og/*
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-*
  Cache-Control: public, max-age=604800
/og-image.jpg
  Cache-Control: public, max-age=604800
/coin-icons/*
  Cache-Control: public, max-age=604800

# The project's pages.dev address serves the same site as cryptopriceticker.com: keep it out of
# search results so only the real domain is indexed (branch previews already get noindex from
# Cloudflare). This rule matches that hostname only, never the custom domain.
https://cryptopriceticker.pages.dev/*
  X-Robots-Tag: noindex

# Widget frames: indexable only inside the pages that embed them.
/embed/*
  X-Robots-Tag: noindex, indexifembedded

# Repository files that are deployed but are not pages.
/scripts/*
  X-Robots-Tag: noindex
/content/*
  X-Robots-Tag: noindex
/docs/*
  X-Robots-Tag: noindex
/tests/*
  X-Robots-Tag: noindex
/.claude/*
  X-Robots-Tag: noindex
/README.md
  X-Robots-Tag: noindex
/CLAUDE.md
  X-Robots-Tag: noindex
/SECURITY.md
  X-Robots-Tag: noindex

